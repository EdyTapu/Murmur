<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened-runtime resource-access exceptions. Murmur is NOT sandboxed,
         but it is signed with the hardened runtime so TCC grants survive
         rebuilds. Under the hardened runtime these entitlements are required
         for the OS to even show the microphone prompt / grant access, and for
         the AppleScript-keystroke insertion fallback to drive System Events. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
